<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup (API 23-30). These are the rules Android applies when AttendoBackupAgent
  lets a pass through — that is, when the student has "Automatic backup" on.

  `attendo.db-wal` is listed as well as the database. Room runs in WAL mode, so a write
  lives in the log until SQLite checkpoints; the app checkpoints whenever it leaves the
  foreground (AppContainer.checkpoint), and backing the log up covers the case where it
  was killed before that ran. The `-shm` file is deliberately left out — it is a scratch
  index that SQLite rebuilds, and a stale copy is worse than none.

  The toggle itself lives in `attendo-android-backup.xml`, and it travels in the backup so
  a restored install keeps the choice it was backed up under; `attendo-appearance.xml`
  rides along for the same reason — a look is a choice too.
-->
<full-backup-content>
    <!-- The community identity file (attendo-community.xml) is deliberately NOT
         listed here, in either direction: an anonymous-auth session token restored
         onto a second device would make one student two reporters. The rules are
         include-lists, so an unlisted file is already excluded — this comment is the
         record that the omission is the security decision, not an oversight. The
         community Room tables ride inside attendo.db and are harmless: cache and
         pending outbox rows, both keyed to a fresh identity after any restore. -->
    <include domain="database" path="attendo.db" />
    <include domain="database" path="attendo.db-wal" />
    <include domain="sharedpref" path="attendo-settings.xml" />
    <include domain="sharedpref" path="attendo-android-backup.xml" />
    <include domain="sharedpref" path="attendo-appearance.xml" />
</full-backup-content>
